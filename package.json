{
  "name": "dsh-agent-processes",
  "version": "1.0.2",
  "description": "Host-owned process & port lifecycle for DeepSeek Harness local agents (start/stop/list/logs/wait-ready + dock chip + Processes rightbar).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-agent-processes.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-agent-processes#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-agent-processes/issues"
  },
  "scripts": {
    "build": "node build.mjs && tsc --noEmit",
    "test": "node --test",
    "smoke": "node scripts/lifecycle-smoke.mjs",
    "prepare": "node build.mjs || node -e \"console.warn('[dsh-agent-processes] prepare: build skipped (build toolchain unavailable); relying on prebuilt lib/')\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "process-manager",
    "port",
    "agent-tools",
    "lifecycle",
    "local-agents",
    "sidebar",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "jandareal@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
